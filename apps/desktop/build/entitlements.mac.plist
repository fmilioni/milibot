<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 (Electron and the bundled Node that runs the daemon) needs JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The daemon's Node loads the better-sqlite3 addon. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The bundled QEMU (Resources/vm/bin/qemu) runs the VM on Hypervisor.framework (HVF). -->
  <key>com.apple.security.hypervisor</key>
  <true/>
</dict>
</plist>
