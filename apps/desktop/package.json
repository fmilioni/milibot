{
  "name": "@milibot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Milibot desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json",
    "dmg:background": "install-electron && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dmg-background/index.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@milibot/shared": "workspace:*",
    "@milibot/vm-host": "workspace:*",
    "@novnc/novnc": "^1.7.0",
    "@tanstack/react-query": "^5.104.0",
    "fflate": "^0.8.3",
    "flubber": "^0.4.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.15",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/flubber": "^0.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
