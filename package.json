{
  "name": "milibot",
  "version": "0.3.0",
  "license": "PolyForm-Shield-1.0.0",
  "homepage": "https://github.com/fmilioni/milibot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm vm:tools && concurrently -k -n daemon,desktop -c blue,magenta \"pnpm --filter @milibot/daemon dev\" \"cross-env MILIBOT_DAEMON_EXTERNAL=1 pnpm --filter @milibot/desktop dev\"",
    "dev:daemon": "pnpm vm:tools && pnpm --filter @milibot/daemon dev",
    "dev:desktop": "pnpm vm:tools && pnpm --filter @milibot/desktop dev",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --filter \"./vm/guest-agent\" build",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" --filter \"./vm/guest-agent\" --filter \"./vm/host\" typecheck",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js .",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:snapshot": "pnpm --filter @milibot/daemon db:snapshot",
    "gen:scripts": "pnpm --filter @milibot/daemon gen:scripts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project dom",
    "test:integration": "vitest run --project integration",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "package": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/package/index.mjs",
    "package:dir": "pnpm package --dir",
    "vm:tools": "node vm/host/src/cli/host-tools.ts",
    "dmg:background": "pnpm --filter @milibot/desktop dmg:background"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "espree": "^11.2.0",
    "globals": "^17.0.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
