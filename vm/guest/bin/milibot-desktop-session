#!/bin/bash
# Started by milibot-desktop@<slug>.service as user bot-<slug>.
set -euo pipefail
: "${DISPLAY_NUM:?}" "${SLUG:?}"

N=$DISPLAY_NUM
export DISPLAY=":$N"
export XAUTHORITY="$HOME/.Xauthority"
export XDG_RUNTIME_DIR="/run/milibot-desktop-$SLUG"
export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE NO_AT_BRIDGE=1
umask 002

rm -rf "$HOME/.cache/sessions"
rm -f "/tmp/.X$N-lock" "/tmp/.X11-unix/X$N" 2>/dev/null || true

touch "$XAUTHORITY"
chmod 600 "$XAUTHORITY"
xauth -q -f "$XAUTHORITY" remove ":$N" 2>/dev/null || true
xauth -q -f "$XAUTHORITY" add ":$N" MIT-MAGIC-COOKIE-1 "$(mcookie)"

XVNC=$(command -v Xtigervnc || command -v Xvnc)
"$XVNC" ":$N" \
  -geometry 1280x800 -depth 24 -dpi 96 \
  -rfbport $((5900 + N)) \
  -SecurityTypes None \
  -AcceptSetDesktopSize=0 \
  -AlwaysShared \
  -auth "$XAUTHORITY" \
  -nolisten tcp \
  -desktop "$SLUG" \
  -s 0 &
xvnc_pid=$!

for _ in $(seq 1 100); do
  [ -S "/tmp/.X11-unix/X$N" ] && break
  kill -0 "$xvnc_pid" 2>/dev/null || { echo "Xvnc :$N exited during startup" >&2; exit 1; }
  sleep 0.1
done
if [ ! -S "/tmp/.X11-unix/X$N" ]; then
  echo "Xvnc :$N did not create its socket in 10 s" >&2
  kill "$xvnc_pid" 2>/dev/null || true
  exit 1
fi
xhost +SI:localuser:agent +SI:localuser:root >/dev/null || echo "xhost failed on :$N; agent and root cannot open windows" >&2
xset s off s noblank 2>/dev/null || true
xset -dpms 2>/dev/null || true

dbus-launch --exit-with-session xfce4-session &
session_pid=$!

set +e
wait -n "$xvnc_pid" "$session_pid"
kill "$session_pid" "$xvnc_pid" 2>/dev/null
exit 1
